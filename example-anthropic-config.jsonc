{
  "$schema": "https://opencode.ai/config.json",

  // Anthropic三方兼容配置示例
  "provider": {
    "anthropic": {
      "options": {
        // 自定义API URL，支持三方兼容的API endpoint
        // 也可以通过环境变量 ANTHROPIC_BASE_URL 设置
        "baseURL": "https://api.your-custom-anthropic-compatible-endpoint.com/v1",

        // 自定义API Key
        // 也可以通过环境变量 ANTHROPIC_AUTH_TOKEN 或 ANTHROPIC_API_KEY 设置
        "apiKey": "your-custom-api-key-here",

        // 自定义headers（可选）
        "headers": {
          "X-Custom-Header": "custom-value",
          "X-Another-Header": "another-value",
        },

        // 模型映射配置（可选，也可以通过环境变量设置）
        // "defaultModel": "MiniMax-M2",              // 默认模型映射
        // "defaultHaikuModel": "MiniMax-M2",         // Haiku 模型映射
        // "defaultSonnetModel": "MiniMax-M2",        // Sonnet 模型映射
        // "defaultOpusModel": "MiniMax-M2",          // Opus 模型映射
      },

      // 可选：覆盖模型配置
      "models": {
        "claude-3-5-sonnet-20241022": {
          "name": "自定义Claude模型名称",
          "cost": {
            "input": 0.003,
            "output": 0.015,
          },
        },
      },
    },
  },

  // 其他配置...
  "model": "anthropic/claude-3-5-sonnet-20241022",
  "theme": "dark",
}
